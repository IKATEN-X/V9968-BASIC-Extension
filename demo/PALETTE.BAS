10 CLEAR 2048:DEFINT A-Z:KEY OFF:_SCREEN(8):COLOR 31,0,0:CLS
20 DIM CR(31),CG(31),CB(31):TW=180:IF (VDP(10) AND 2)<>0 THEN TW=150
30 FOR I=0 TO 31:A!=I*6.2831853/32:CR(I)=15.5+15.5*SIN(A!):CG(I)=15.5+15.5*SIN(A!+2.0943951):CB(I)=15.5+15.5*SIN(A!+4.1887902):NEXT I
40 FOR N=0 TO 255:I=N MOD 32:R=CR(I)*(N\32)/7:G=CG(I)*(N\32)/7:B=CB(I)*(N\32)/7:IF N<32 THEN R=N:G=N:B=N
50 _COLOR=(N,R,G,B):IF INKEY$=CHR$(27) THEN 900
60 NEXT N
70 OPEN "GRP:" AS #1:PSET(16,8):PRINT #1,"V9968 / SCREEN 8 PALETTE";
80 FOR I=0 TO 31:LINE(I*8,24)-(I*8+7,39),I,BF:NEXT I
90 FOR X=0 TO 255:LINE(X,48)-(X,143),64+(X\4 MOD 32):NEXT X
100 FOR R=63 TO 1 STEP -1:CIRCLE(64,96),R,128+(R MOD 32),,,0.72:CIRCLE(192,96),R,192+(R MOD 32),,,0.72
110 IF INKEY$=CHR$(27) THEN 900
120 NEXT R
130 FOR N=0 TO 255:X=(N MOD 16)*16:Y=148+(N\16)*4:LINE(X,Y)-(X+15,Y+3),N,BF:NEXT N
140 _WAIT VDP:TIME=0
150 IF INKEY$=CHR$(27) THEN 900
160 IF TIME<TW THEN 150
200 P=0:PA=0:GR=0
210 K$=INKEY$:IF K$=CHR$(27) THEN 900
220 IF K$=" " THEN PA=1-PA
230 IF K$="C" OR K$="c" THEN GR=1-GR
240 IF PA THEN 210
250 _WAIT VBLANK
260 FOR J=0 TO 2:FOR I=0 TO 31:Q=(I+P+J*10) MOD 32:R=CR(Q)*(J+2)/4:G=CG(Q)*(J+2)/4:B=CB(Q)*(J+2)/4:IF GR THEN R=Q:G=Q:B=Q
270 _COLOR=(64+J*64+I,R,G,B)
280 NEXT I,J
290 P=(P+1) MOD 32:GOTO 210
900 CLOSE:_SCREEN(0):KEY ON:DEFSNG A-Z:PRINT "V9968 palette demo stopped.":END
