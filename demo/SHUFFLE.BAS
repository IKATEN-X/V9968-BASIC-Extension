10 DEFINT A-Z:KEY OFF:_SCREEN(0):OPEN "GRP:" AS #1
20 DIM R(7):P$="":FOR J=0 TO 7:READ R(J):P$=P$+CHR$(R(J)):NEXT J
30 M=1:GOSUB 1000
100 K$=INKEY$:IF K$=CHR$(27) THEN 900
110 IF K$="1" AND M<>1 THEN M=1:GOSUB 1000
120 IF K$="2" AND M<>2 THEN M=2:GOSUB 1000
130 IF K$="s" OR K$="S" THEN SF=1-SF:_SCREEN(,,,,,,SF):GOSUB 2000
140 _WAIT VBLANK:GOTO 100
900 CLOSE #1:_SCREEN(0):KEY ON:DEFSNG A-Z:PRINT "V9968 shuffle demo stopped.":END
1000 _SCREEN(,,,,,,0):SCREEN M*2,1,,,,0:VDP(9)=VDP(9) AND &HFD:COLOR 15,1,1:CLS
1010 SF=0:N=8*M:D=256\N:SPRITE$(0)=P$
1020 REM SPS IGNORES END MARKERS; HIDE EVERY UNUSED PLANE EXPLICITLY
1030 FOR I=0 TO 31:PUT SPRITE I,(0,224),0,0:NEXT I
1040 LINE(0,0)-(255,0),15,BF:PRESET(8,16):PRINT #1,"SPRITE MODE";M;
1050 PRESET(168,16):PRINT #1,N\2;"/ LINE";
1060 PRESET(8,120):PRINT #1,"PATTERN";
1070 FOR I=0 TO N-1:X=I*D+(D-16)\2:C=3+2*(I MOD 4)
1080 LINE(X,68)-(X+15,91),14,B:PRESET(X+4,100):PRINT #1,HEX$(I);
1090 FOR J=0 TO 7:FOR B=0 TO 7
1100 IF R(J) AND 2^(7-B) THEN LINE(X+B*2,136+J*2)-(X+B*2+1,137+J*2),C,BF
1110 NEXT B:NEXT J
1120 PUT SPRITE I,(X,72),C,0:NEXT I
1130 GOSUB 2000:RETURN
2000 LINE(8,40)-(119,47),1,BF:PRESET(8,40)
2010 IF SF=0 THEN PRINT #1,"SHUFFLE OFF";:RETURN
2020 PRINT #1,"SHUFFLE ON";:RETURN
3000 DATA 24,60,126,255,255,126,60,24
