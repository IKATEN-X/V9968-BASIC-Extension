10 DEFINT A-Z:SCREEN 7:COLOR 15,9,9:CLS
20 R=VDP(21):B=VDP(13):V=VDP(22)
30 VDP(22)=V AND 254:VDP(21)=R OR 1
40 FOR I=33 TO 44:VDP(I)=0:NEXT I
50 VDP(37)=64:VDP(39)=64:VDP(41)=8:VDP(43)=1
60 VDP(13)=3:VDP(45)=5:VDP(46)=0
70 VDP(47)=&H20
80 T=TIME
90 IF TIME=T THEN 90
100 VDP(47)=0
110 A$="":FOR I=0 TO 7:A$=A$+HEX$(POINT(64+I,64)):NEXT I
120 VDP(13)=B:VDP(21)=R:VDP(22)=V
130 SCREEN 0:WIDTH 40:COLOR 15,4,4:CLS
140 PRINT "LFMC: NO BITMAP DATA SENT"
150 PRINT "EXPECTED: 99999999"
160 PRINT "ACTUAL:   ";A$
170 IF A$="99999999" THEN PRINT "UNCHANGED (EXPECTED)" ELSE PRINT "UNEXPECTED DRAWING"
180 END
