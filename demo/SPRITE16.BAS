10 DEFINT A-Z:KEY OFF:_SCREEN(0):OPEN "GRP:" AS #1
20 DIM R(7):P$="":FOR J=0 TO 7:READ R(J):P$=P$+CHR$(R(J)):NEXT J
30 M=1:GOSUB 1000
100 K$=INKEY$:IF K$=CHR$(27) THEN 900
110 IF K$="1" AND M<>1 THEN M=1:GOSUB 1000
120 IF K$="2" AND M<>2 THEN M=2:GOSUB 1000
130 IF K$=" " OR K$="t" OR K$="T" THEN SF=SF XOR 2:_SCREEN(,,,,,,SF):GOSUB 2000
140 IF K$="s" OR K$="S" THEN SF=SF XOR 1:_SCREEN(,,,,,,SF):GOSUB 2000
150 GOTO 100
900 CLOSE #1:_SCREEN(0):KEY ON:DEFSNG A-Z:PRINT "V9968 sprite16 demo stopped.":END
1000 _SCREEN(,,,,,,0):SCREEN M*2,0,,,,0:VDP(9)=VDP(9) AND &HFD:COLOR 15,1,1:CLS
1010 SF=0:SPRITE$(0)=P$
1020 FOR I=0 TO 31:PUT SPRITE I,(0,224),0,0:NEXT I
1030 LINE(0,0)-(255,0),15,BF:PRESET(8,16):PRINT #1,"SPRITE MODE";M;
1035 PRESET(8,56):PRINT #1,"32 SPRITES";
1040 PRESET(8,120):PRINT #1,"PATTERN";
1045 PRESET(8,100):PRINT #1,"00-07   08-0F   10-17   18-1F";
1047 FOR I=0 TO 3:LINE(I*64+1,88)-(I*64+62,88),14:NEXT I
1050 FOR I=0 TO 31:X=I*8:C=3+2*(I MOD 4)
1070 FOR J=0 TO 7:FOR B=0 TO 7
1080 IF R(J) AND 2^(7-B) THEN PSET(X+B,136+J),C
1090 NEXT B:NEXT J
1100 PUT SPRITE I,(X,72),C,0:NEXT I
1110 GOSUB 2000:RETURN
2000 L=M*4:IF SF AND 2 THEN L=16
2010 LINE(168,16)-(247,23),1,BF:PRESET(168,16):PRINT #1,L;"/ LINE";
2020 LINE(8,40)-(87,47),1,BF:PRESET(8,40)
2030 IF SF AND 2 THEN PRINT #1,"S16 ON"; ELSE PRINT #1,"S16 OFF";
2040 LINE(144,40)-(239,47),1,BF:PRESET(144,40)
2050 IF SF AND 1 THEN PRINT #1,"SHUFFLE ON"; ELSE PRINT #1,"SHUFFLE OFF";
2060 RETURN
3000 DATA 24,60,126,255,255,126,60,24
