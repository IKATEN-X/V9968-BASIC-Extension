<?xml version="1.0"?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>
  <info>
    <manufacturer>V9968 BASIC project</manufacturer>
    <code>V9968 BASIC</code>
    <description>MSX2+ BASIC with an internal V9968, 128 KB RAM, no disk ROM.</description>
    <type>MSX2+</type>
    <region>jp</region>
  </info>
  <MapperReadBackBits>largest</MapperReadBackBits>
  <CassettePort/>
  <devices>
    <primary slot="0">
      <ROM id="MSX BIOS with BASIC ROM">
        <mem base="0x0000" size="0x8000"/>
        <rom><filename>MSX2P.rom</filename></rom>
      </ROM>
    </primary>
    <primary external="true" slot="1"/>
    <primary external="true" slot="2"/>
    <primary slot="3">
      <secondary slot="0">
        <MemoryMapper id="Main RAM">
          <mem base="0x0000" size="0x10000"/>
          <size>128</size>
        </MemoryMapper>
      </secondary>
      <secondary slot="1">
        <ROM id="MSX Sub ROM">
          <mem base="0x0000" size="0x4000"/>
          <rom><filename>MSX2PEXT.rom</filename></rom>
        </ROM>
      </secondary>
    </primary>
    <PPI id="ppi">
      <io base="0xA8" num="4"/>
      <sound><volume>16000</volume></sound>
      <keyboard_type>jp_jis</keyboard_type>
      <has_keypad>false</has_keypad>
      <key_ghosting>false</key_ghosting>
      <code_kana_locks>true</code_kana_locks>
      <graph_locks>false</graph_locks>
    </PPI>
    <VDP id="VDP">
      <version>V9968</version>
      <vram>256</vram>
      <io base="0x98" num="5" type="O"/>
      <io base="0x98" num="5" type="I"/>
      <timing>0</timing>
    </VDP>
    <PSG id="PSG">
      <type>YM2149</type>
      <io base="0xA0" num="4" type="IO"/>
      <sound><volume>21000</volume></sound>
    </PSG>
    <RTC id="Real time clock">
      <io base="0xB4" num="2" type="O"/>
      <io base="0xB5" num="1" type="I"/>
      <sramname>v9968-basic.cmos</sramname>
    </RTC>
    <PrinterPort id="Printer Port"><io base="0x90" num="2"/></PrinterPort>
    <ResetStatusRegister id="Reset Status register">
      <io base="0xF4" num="1"/><inverted>true</inverted>
    </ResetStatusRegister>
  </devices>
</msxconfig>
