10 DEFINT A-Z:KEY OFF:_V9968:_SCREEN(5)
20 N=24:DIM PH(N-1),DV(N-1),MG(N-1),AT(N-1),XT(127,2),YT(127,2),SW(127),SH(127),FT(127)
30 _SET PAGE(2,2):_CLS(0)
40 GOSUB 1000:GOSUB 2000:GOSUB 500
50 _SPRITE(3):_SPRITE OFF:SP=1:PA=0:OT=0:BG=0
60 FOR I=0 TO N-1
70 PH(I)=I*19 AND 127:DV(I)=1+I MOD 2
90 MG(I)=1:AT(I)=0
100 IF I<4 THEN MG(I)=2:AT(I)=25+25*(I MOD 3)
110 IF I>=4 AND I MOD 5=0 THEN AT(I)=50
120 K=PH(I):G=MG(I)
130 _PUT SPRITE(I,XT(K,G),YT(K,G)),1+(I MOD 4),1792+(I MOD 4),SIZE(SW(K)*G,SH(K)*G),TRANS(AT(I)),FLIP(FT(K))
140 NEXT I
150 GOSUB 1500
160 _SET PAGE(0,0):_SPRITE ON
200 K$=INKEY$:IF K$=CHR$(27) THEN 900
210 IF K$=" " THEN PA=1-PA
220 IF K$="t" OR K$="T" THEN OT=1-OT:GOSUB 2500
230 IF K$="b" OR K$="B" THEN BG=1-BG:_WAIT VBLANK:_SET PAGE(BG,0)
240 IF K$="+" AND SP<3 THEN SP=SP+1
250 IF K$="-" AND SP>1 THEN SP=SP-1
260 IF PA THEN _WAIT VBLANK:GOTO 200
270 FOR I=0 TO N-1
280 PH(I)=(PH(I)+DV(I)*SP) AND 127:K=PH(I):G=MG(I)
290 _PUT SPRITE(I,XT(K,G),YT(K,G)),,,SIZE(SW(K)*G,SH(K)*G),FLIP(FT(K))
300 NEXT I
310 GOTO 200
500 REM PRECOMPUTED BOUNCE AND PULSE TABLES
510 FOR K=0 TO 127:SW(K)=16+ABS(31-(K AND 63))\2:SH(K)=16+ABS(31-((K+16) AND 63))\2
520 T=K:Q=(K*3+17) AND 127:F=0
530 IF T>63 THEN T=127-T:F=1
540 IF Q>63 THEN Q=127-Q:F=F+2
550 FT(K)=F:FOR G=1 TO 2
560 XT(K,G)=2+T*(252-SW(K)*G)\63:YT(K,G)=2+Q*(208-SH(K)*G)\63
570 NEXT G:NEXT K:RETURN
900 _SCREEN(0):KEY ON:DEFSNG A-Z:PRINT "V9968 sprite demo stopped.":RUN"A:MENU.BAS"
1000 REM BACKGROUND AND FOUR SPRITE PALETTES
1010 RESTORE 3000:FOR I=0 TO 7:READ R,G,B:_COLOR=(I,R,G,B):NEXT I
1020 FOR C=1 TO 4:READ R,G,B
1030 _COLOR=(16*C+2,R,G,B):_COLOR=(16*C+3,R\2,G\2,B\2)
1040 _COLOR=(16*C+4,(R+31)\2,(G+31)\2,(B+31)\2):_COLOR=(16*C+15,31,31,31)
1050 NEXT C:RETURN
1500 REM DRAW FOUR PATTERNS ON THE VISIBLE PAGE
1510 _SET PAGE(2,2):_CLS(0)
1520 FOR Y=0 TO 15:A=ABS(15-2*Y)\2
1530 _LINE (A,Y)-(7,Y),2,BF:_LINE (8,Y)-(15-A,Y),3,BF:NEXT Y
1540 _LINE (7,1)-(1,7),4:_LINE (7,2)-(7,5),15
1550 _LINE (18,1)-(29,14),2,BF:_LINE (17,2)-(30,13),2,BF
1560 _LINE (19,3)-(28,12),3,BF:_LINE (20,4)-(27,11),2,BF
1570 _LINE (19,2)-(27,2),15:_LINE (18,3)-(18,10),4
1580 _LINE (38,1)-(41,14),2,BF:_LINE (33,6)-(46,9),2,BF
1590 _LINE (36,4)-(43,11),2,BF:_LINE (39,5)-(43,10),3,BF:_LINE (38,2)-(38,6),15
1600 _LINE (49,6)-(56,9),2,BF
1610 FOR I=0 TO 5:_LINE (56+I,2+I)-(56+I,13-I),3:NEXT I
1620 _LINE (56,3)-(60,7),4:_PSET(57,4),15
1625 _COPY (0,0)-(63,15),2 TO (0,0),7
1630 _WAIT VDP:TW=180:IF (VDP(10) AND 2)<>0 THEN TW=150
1640 TIME=0
1650 IF TIME<TW THEN 1650
1660 RETURN
2000 REM TWO BACKGROUND PAGES FOR A/B COMPARISON
2010 _SET PAGE(2,1):_CLS(1):_SET PAGE(2,0):_CLS(1)
2020 FOR Y=0 TO 191 STEP 24:FOR X=0 TO 224 STEP 32
2030 C=1+X\96+((X\32+Y\24) MOD 2):_LINE (X,Y)-(X+31,Y+23),C,BF
2040 NEXT X:NEXT Y
2050 _LINE (0,58)-(255,73),5,BF:_LINE (0,138)-(255,153),6,BF
2060 _LINE (0,104)-(255,107),7,BF:_LINE (0,192)-(255,211),2,BF
2070 _LINE (0,0)-(255,211),3,B:_WAIT VDP:RETURN
2500 REM CHANGE TRANSPARENCY WITHOUT MOVING THE SPRITES
2510 FOR I=0 TO N-1:K=PH(I):G=MG(I)
2520 _PUT SPRITE(I,XT(K,G),YT(K,G)),,,TRANS(AT(I)*(1-OT))
2530 NEXT I:RETURN
3000 DATA 0,0,0,3,4,6,7,9,12,13,16,18,24,25,24,5,17,15,21,8,14,29,22,7
3010 DATA 2,28,25,31,9,17,31,24,5,11,27,12
