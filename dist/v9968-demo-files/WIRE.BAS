545 Y1!=Y!*CB!-Z1!*SB!:Z2!=Y!*SB!+Z1!*CB!:PZ!(I)=Z2!
550 F!=ZO/(4-Z2!):PX(I,F)=INT(256+X1!*F!+.5):PY(I,F)=INT(112-Y1!*F!*.5+.5):NEXT I
555 FOR I=0 TO NE-1:D!=PZ!(EA(I))+PZ!(EB(I)):C=15
560 IF D!<-1.2 THEN C=C0 ELSE IF D!<0 THEN C=C1 ELSE IF D!<1.2 THEN C=C2
