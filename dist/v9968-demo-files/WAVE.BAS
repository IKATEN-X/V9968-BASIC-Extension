10 DEFINT A-Z:KEY OFF:_SCREEN(0):WIDTH 40:COLOR 15,1,1:CLS
20 LOCATE 13,10:PRINT "SPRITE WAVE":DIM Y(63,16),E(63)
30 P$="":FOR I=0 TO 7:READ B:P$=P$+CHR$(B):NEXT I
40 REM PRECOMPUTE SINE POSITIONS AND THE AMPLITUDE ENVELOPE
50 FOR K=0 TO 63:T!=K*.0981747704:S!=SIN(T!)
60 E(K)=INT(8+8*COS(T!)+.5)
70 FOR A=0 TO 16:Y(K,A)=120+INT(S!*A*3+.5):NEXT A:NEXT K
80 OPEN "GRP:" AS #1:M=1:SF=0:F=0:PA=0:GOSUB 1000
100 K$=INKEY$:IF K$=CHR$(27) THEN 900
110 IF K$=" " THEN PA=1-PA:GOSUB 2000
120 IF K$="1" AND M<>1 THEN M=1:GOSUB 1000
130 IF K$="2" AND M<>2 THEN M=2:GOSUB 1000
140 IF K$="t" OR K$="T" THEN SF=SF XOR 2:_SCREEN(,,,,,,SF):GOSUB 2000
150 IF K$="s" OR K$="S" THEN SF=SF XOR 1:_SCREEN(,,,,,,SF):GOSUB 2000
160 IF PA THEN 100
170 F=(F+1) AND 63:GOSUB 3000:GOTO 100
900 CLOSE #1:_SCREEN(0):KEY ON:DEFSNG A-Z:PRINT "V9968 wave demo stopped.":RUN"A:MENU.BAS"
1000 _SCREEN(,,,,,,0):SCREEN M*2,0,,,,0:VDP(9)=VDP(9) AND &HFD:COLOR 15,1,1:CLS:SPRITE$(0)=P$
1010 FOR I=0 TO 31:PUT SPRITE I,(I*8,120),3+2*(I MOD 4),0:NEXT I
1020 LINE(0,0)-(255,0),15:PRESET(8,16):PRINT #1,"SPRITE MODE";M;
1030 PRESET(8,56):PRINT #1,"SPRITE WAVE";:PRESET(8,184):PRINT #1,"32 SPRITES";
1040 GOSUB 3000:_SCREEN(,,,,,,SF):GOSUB 2000:RETURN
2000 L=M*4:IF SF AND 2 THEN L=16
2010 LINE(168,16)-(247,23),1,BF:PRESET(168,16):PRINT #1,L;"/ LINE";
2020 LINE(8,40)-(87,47),1,BF:PRESET(8,40)
2030 IF SF AND 2 THEN PRINT #1,"S16 ON"; ELSE PRINT #1,"S16 OFF";
2040 LINE(144,40)-(239,47),1,BF:PRESET(144,40)
2050 IF SF AND 1 THEN PRINT #1,"SHUFFLE ON"; ELSE PRINT #1,"SHUFFLE OFF";
2060 LINE(184,56)-(247,63),1,BF:PRESET(184,56)
2070 IF PA THEN PRINT #1,"PAUSED"; ELSE PRINT #1,"RUNNING";
2080 RETURN
3000 A=E(F):K=(F+F) AND 63:X=0
3010 FOR I=0 TO 31:PUT SPRITE I,(X,Y(K,A)):X=X+8:K=(K+2) AND 63:NEXT I:RETURN
4000 DATA 24,60,126,255,255,126,60,24
