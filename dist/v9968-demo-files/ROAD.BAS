10 CLEAR 512:DEFINT A-Z:KEY OFF:ON ERROR GOTO 950:ON STOP GOSUB 980:STOP ON
15 PX=120:SG=0:D=0:E$=CHR$(27)
20 _SCREEN(5,,0,,,,,1):_SET PAGE(0,0):_CLS(0):_SPRITE(3):_SPRITE OFF:SET SCROLL ,0
30 OPEN "A:ROAD.PAL" FOR INPUT AS #1:FOR I=0 TO 31:INPUT #1,C,R,G,B:_COLOR=(C,R,G,B):NEXT I:CLOSE #1
40 COLOR 15,0,0:OPEN "GRP:" AS #1:PRESET(88,100):PRINT #1,"LOADING...";:CLOSE #1
50 _SET PAGE(0,1):BLOAD"A:CAR.SC5",S:_COPY(0,0)-(15,31),1 TO(0,0),7
60 BLOAD"A:ROAD.SC5",S
70 C=128:K=2:TG=2:CT=0:PH=0:DP=2:Q!=RND(-TIME-1)
80 FOR BT=240 TO 0 STEP -16:GOSUB 500:NEXT BT
90 _COPY(0,0)-(255,255),2 TO(0,0),0:_SET PAGE(0,0):DP=0
95 _PUT SPRITE(0,PX,168),1,1792,SIZE(16,32),PATTERN(32):_SPRITE ON
100 ' MAIN LOOP
115 IF INKEY$=E$ THEN 900
110 IF (SG AND 15)=0 THEN BT=(SG-16) AND 255:GOSUB 500
120 SG=(SG-4) AND 255:VDP(24)=SG
130 D=STICK(0):IF D=0 THEN D=STICK(1)
140 IF D=0 THEN 800 ELSE ON D GOTO 800,160,160,160,800,170,170,170
160 IF PX=240 THEN 800 ELSE PX=PX+4:_PUT SPRITE(0,PX,168):GOTO 800
170 IF PX=0 THEN 800 ELSE PX=PX-4:_PUT SPRITE(0,PX,168):GOTO 800
500 CT=CT-1:IF CT<=0 THEN TG=INT(RND(1)*5):CT=6+INT(RND(1)*9)
510 IF C<104 THEN TG=4 ELSE IF C>152 THEN TG=0
520 IF K<TG THEN K=K+1 ELSE IF K>TG THEN K=K-1
530 SY=(K*2+PH)*16
540 _COPY(0,160)-(255,175),1 TO(0,BT),DP
550 _COPY(0,SY)-(159,SY+15),1 TO(C-80,BT),DP
560 C=C+(K-2)*4:PH=1-PH:RETURN
800 _WAIT VBLANK:GOTO 100
900 ' LEAVE DEMO
910 _SPRITE OFF:SET SCROLL ,0:_SCREEN(0):KEY ON:DEFSNG A-Z:PRINT "V9968 road demo stopped.":RUN"A:MENU.BAS"
950 ' ERROR
960 EE=ERR:EL=ERL:RESUME 960
970 ON ERROR GOTO 0:CLOSE:_SCREEN(0):KEY ON:PRINT "ROAD ERROR";EE;" AT";EL:END
980 ' END DEMO
990 _SPRITE OFF:SET SCROLL ,0:_SCREEN(0):KEY ON:DEFSNG A-Z
