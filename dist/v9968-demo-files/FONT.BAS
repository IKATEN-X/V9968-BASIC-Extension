10 CLEAR 4096:DEFINT A-Z:KEY OFF:_V9968:_SCREEN(5):_SET PAGE(2,2):_CLS(1)
20 _COLOR=(1,2,3,5):_COLOR=(3,3,25,19):_COLOR=(6,31,12,18):_COLOR=(10,31,28,8):_COLOR=(15,31,31,31)
30 DIM R$(26),CL(3):CL(0)=3:CL(1)=6:CL(2)=10:CL(3)=15:TW=180:IF (VDP(10) AND 2)<>0 THEN TW=150
40 OPEN "GRP:" AS #1:COLOR 15,1,1:PSET(16,8):PRINT #1,"V9968 / FONT DATA";
50 _FONT(1)
60 FOR N=0 TO 255
70 IF N>=240 AND N<=243 THEN A$="":FOR I=0 TO 7:READ V:A$=A$+CHR$(V):NEXT I:_FONT$(N)=A$
80 COLOR 15:IF N>=240 AND N<=243 THEN COLOR 3
90 PSET(16+(N MOD 16)*14,32+(N\16)*10):A$=CHR$(N):IF N<32 THEN A$=CHR$(1)+CHR$(64+N)
100 PRINT #1,A$;:IF INKEY$=CHR$(27) THEN 900
110 NEXT N
120 X=RND(-TIME-1):FOR R=0 TO 26:FOR I=1 TO 32:C=33+INT(RND(1)*98):IF C>126 THEN C=C+113
130 R$(R)=R$(R)+CHR$(C):NEXT I:IF INKEY$=CHR$(27) THEN 900
140 NEXT R:_WAIT VDP
150 GOSUB 800
200 _SET PAGE(0,0):_CLS(1):COLOR 15,1,1
210 PSET(16,8):PRINT #1,"V9968 FONT / GRP:";
220 PSET(16,40):PRINT #1,"ABCDEFGHIJKLMNOPQRSTUVWXYZ";
230 PSET(16,56):PRINT #1,"abcdefghijklmnopqrstuvwxyz";
240 PSET(16,72):PRINT #1,"0123456789 !? +-*/=()[]";
250 COLOR 3:PSET(16,104):FOR I=1 TO 4:PRINT #1,CHR$(240)+CHR$(241)+CHR$(242)+CHR$(243);:NEXT I
260 COLOR 6:PSET(16,136):PRINT #1,USING "###.##";12.5
270 _WAIT VDP
280 GOSUB 800
300 PSET(0,0):FOR R=0 TO 26:COLOR CL(R AND 3):PRINT #1,R$(R);:IF INKEY$=CHR$(27) THEN 900
310 NEXT R:_WAIT VDP
320 IF INKEY$<>CHR$(27) THEN 320 ELSE 900
800 TIME=0
810 IF INKEY$=CHR$(27) THEN 900
820 IF TIME<TW THEN 810
830 RETURN
900 CLOSE #1:_FONT(0):_SCREEN(0):KEY ON:DEFSNG A-Z:PRINT "V9968 font demo stopped.":RUN"A:MENU.BAS"
